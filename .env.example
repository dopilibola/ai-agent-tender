# ── Required ────────────────────────────────────────────────────────────────
# Google AI Studio → https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (message @userinfobot). The bot ignores everyone else.
TELEGRAM_OWNER_CHAT_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# Default: SQLite in ./data/. Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/freelancehunter
DATABASE_URL=

LOG_LEVEL=INFO

# Platform API tokens (used from step 2 on). Never put platform *passwords* here:
# browser logins live only in the Playwright profile folder.
FREELANCER_COM_TOKEN=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=

# Email watcher (step 4). Gmail → Security → App passwords.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_APP_PASSWORD=

# Google Sheets mirror (optional): path to a service-account JSON file
GOOGLE_SHEETS_CREDENTIALS_FILE=

# 🌐 /tender/lots sahifasi uchun kalit (tavsiya etiladi, link ochiq internetda bo'lsa).
# Bo'lsa sahifa faqat https://.../tender/lots?key=<WEB_TOKEN> bilan ochiladi.
WEB_TOKEN=
